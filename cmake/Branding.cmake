# The ONLY place the product name is defined.
# Code reaches it through the generated header <dsptb/branding.h>.
set(DSPTB_APP_NAME "DSP Toolbox" CACHE STRING "Display name of the product")
set(DSPTB_EXE_NAME "DSPToolbox" CACHE STRING "Executable base name")
set(DSPTB_DATA_DIR_NAME "DSPToolbox" CACHE STRING "Per-user data directory name")

# Generates ${CMAKE_BINARY_DIR}/generated/dsptb/branding.h
function(dsptb_generate_branding)
  set(out "${CMAKE_BINARY_DIR}/generated/dsptb/branding.h")
  file(CONFIGURE OUTPUT "${out}" CONTENT [=[
// Generated by cmake/Branding.cmake. Do not edit.
#pragma once
#define DSPTB_APP_NAME "@DSPTB_APP_NAME@"
#define DSPTB_EXE_NAME "@DSPTB_EXE_NAME@"
#define DSPTB_DATA_DIR_NAME "@DSPTB_DATA_DIR_NAME@"
#define DSPTB_VERSION_STRING "@PROJECT_VERSION@"
]=] @ONLY)
  add_library(dsptb_branding INTERFACE)
  target_include_directories(dsptb_branding INTERFACE "${CMAKE_BINARY_DIR}/generated")
endfunction()
