{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "DSPTB_RT_GUARD": "ON" }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-release-asio",
      "displayName": "Windows Release with ASIO (the published build)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "DSPTB_ENABLE_ASIO": "ON" }
    },
    {
      "name": "rt-check",
      "displayName": "Release + audio-thread allocation guard",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "DSPTB_RT_GUARD": "ON" }
    },
    {
      "name": "windows-release-gpu",
      "displayName": "Windows Release with the GPU runtime (dev-only; needs an NVIDIA GPU to run its tests)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "DSPTB_GPU_RUNTIME": "ON" }
    },
    {
      "name": "rt-check-gpu",
      "displayName": "Release + allocation guard + GPU runtime",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "DSPTB_RT_GUARD": "ON", "DSPTB_GPU_RUNTIME": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "windows-release-asio", "configurePreset": "windows-release-asio" },
    { "name": "rt-check", "configurePreset": "rt-check" },
    { "name": "windows-release-gpu", "configurePreset": "windows-release-gpu" },
    { "name": "rt-check-gpu", "configurePreset": "rt-check-gpu" }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-release-asio",
      "configurePreset": "windows-release-asio",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "rt-check",
      "configurePreset": "rt-check",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-release-gpu",
      "configurePreset": "windows-release-gpu",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "rt-check-gpu",
      "configurePreset": "rt-check-gpu",
      "output": { "outputOnFailure": true }
    }
  ]
}
