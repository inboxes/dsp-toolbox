// @MODULE_NAME@ (@MODULE_ID@). A starting point: an RMS level reading. Replace analyze() with your own analysis.

#include <dsptb/sdk.hpp>

#include <atomic>
#include <cmath>
#include <cstdio>
#include <string>

DSPTB_DEFINE_RT_GUARD();

class @CLASS@ final : public dsptb::Analyzer<@CLASS@> {
public:
    static constexpr dsptb::ModuleInfo info{.id = "@MODULE_ID@",
                                            .name = "@MODULE_NAME@",
                                            .version = "0.1.0",
                                            .vendor = "Unknown",
                                            .description = "Starting point for an analyzer.",
                                            .caps = 0,
                                            .defaultTap = DSPTB_TAP_POST};
    static constexpr auto params = dsptb::noParams();

    void analyze(dsptb::AnalyzeBlock& b) override {
        double sum = 0.0;
        for (uint32_t i = 0; i < b.frames(); ++i)
            sum += static_cast<double>(b.channel(0)[i]) * b.channel(0)[i];
        const double rms = b.frames() ? std::sqrt(sum / b.frames()) : 0.0;
        rmsDb_.store(rms > 1e-6 ? static_cast<float>(20.0 * std::log10(rms)) : -120.0f, std::memory_order_relaxed);
    }

    void draw(dsptb::Canvas& c) override {
        char text[48];
        std::snprintf(text, sizeof(text), "RMS: %.1f dB", static_cast<double>(rmsDb_.load(std::memory_order_relaxed)));
        c.label(text);
    }

    std::string dumpFrames() override {
        char text[48];
        std::snprintf(text, sizeof(text), "{\"rmsDb\":%.3f}", static_cast<double>(rmsDb_.load(std::memory_order_relaxed)));
        return text;
    }

private:
    std::atomic<float> rmsDb_{-120.0f};
};

DSPTB_REGISTER_MODULES(@CLASS@);
